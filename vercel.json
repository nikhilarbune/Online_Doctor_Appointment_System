{
    "version": 2,
    "buildCommand": "pip install -r backend/requirements.txt && python backend/manage.py migrate",
    "env": {
        "DJANGO_SETTINGS_MODULE": "config.settings",
        "DEBUG": "False"
    },
    "functions": {
        "api/index.py": {
            "memory": 1024,
            "maxDuration": 30
        }
    }
}